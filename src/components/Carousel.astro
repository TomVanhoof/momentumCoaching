---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { getContent, type Lang } from '../i18n';

interface Slide {
  src: ImageMetadata;
  alt: string;
  /** CSS object-position for the crop */
  position?: string;
}
interface Props {
  slides: Slide[];
  label: string;
  width: number;
  height: number;
  sizes: string;
  /** CSS aspect-ratio of the frame */
  aspect?: string;
  maxHeight?: number;
  /** Load the first slide eagerly (above the fold) */
  eager?: boolean;
  lang?: Lang;
}
const { slides, label, width, height, sizes, aspect = '4 / 5', maxHeight, eager = false, lang = 'en' } = Astro.props;
const { ui } = getContent(lang);
const frame = `--aspect: ${aspect};${maxHeight ? ` --max-h: ${maxHeight}px;` : ''}`;
---

<div class="carousel" data-carousel role="group" aria-roledescription="carousel" aria-label={label} style={frame}>
  <div class="track" tabindex="0">
    {slides.map((s, i) => (
      <div class="slide">
        <Image
          src={s.src}
          alt={s.alt}
          width={width}
          height={height}
          widths={[Math.round(width / 2), Math.round(width * 0.8), width]}
          sizes={sizes}
          loading={eager && i === 0 ? 'eager' : 'lazy'}
          fetchpriority={eager && i === 0 ? 'high' : undefined}
          style={s.position ? `object-position: ${s.position}` : undefined}
        />
      </div>
    ))}
  </div>
  <button type="button" class="nav prev" data-prev aria-label={ui.prevPhoto}>
    <span class="flip"><Icon name="arrow" size={20} /></span>
  </button>
  <button type="button" class="nav next" data-next aria-label={ui.nextPhoto}>
    <Icon name="arrow" size={20} />
  </button>
  <div class="dots" aria-hidden="true">
    {slides.map((_, i) => <span class:list={['dot', { active: i === 0 }]} data-dot></span>)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const dots = root.querySelectorAll('[data-dot]');
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const n = dots.length;
      track.scrollTo({ left: ((i + n) % n) * track.clientWidth });
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index() - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index() + 1));
    track.addEventListener('scroll', () => {
      const i = index();
      dots.forEach((d, j) => d.classList.toggle('active', i === j));
    }, { passive: true });
  });
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    border-radius: var(--radius-photo);
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .slide :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: var(--aspect);
    max-height: var(--max-h, none);
    object-fit: cover;
    object-position: 55% 30%;
  }
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-ink);
    box-shadow: 0 6px 20px rgba(33, 33, 33, 0.15);
    cursor: pointer;
  }
  .prev {
    left: 12px;
  }
  .next {
    right: 12px;
  }
  .flip {
    display: flex;
    transform: scaleX(-1);
  }
  .dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    transition: background 0.2s, width 0.2s;
  }
  .dot.active {
    width: 24px;
    border-radius: 4px;
    background: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>
