---
import SectionHeading from './SectionHeading.astro';
import type { Part } from '../data/content.en';
interface Props {
  eyebrow?: string;
  title: Part[];
  intro?: string;
  items: { q: string; a: string }[];
  id?: string;
}
const { eyebrow, title, intro, items, id = 'faq' } = Astro.props;
---

<section {id} class="band-dark">
  <div class="container section faq">
    <SectionHeading {eyebrow} {title}>
      {intro && <p class="intro">{intro}</p>}
    </SectionHeading>
    <div class="list" data-faq>
      {items.map((item, i) => (
        <details open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="icon" aria-hidden="true"></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Animated accordion: the card grows/shrinks in height, and opening one closes the others.
  const DURATION = 300;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
    const items = Array.from(list.querySelectorAll('details'));
    const running = new WeakMap<HTMLDetailsElement, Animation>();

    const setOpen = (d: HTMLDetailsElement, open: boolean) => {
      running.get(d)?.cancel();
      const summary = d.querySelector('summary') as HTMLElement;
      const from = d.offsetHeight;
      if (open) d.open = true;
      const to = open ? d.offsetHeight : summary.offsetHeight;
      if (reduceMotion.matches || from === to) {
        d.open = open;
        return;
      }
      d.style.overflow = 'hidden';
      const anim = d.animate(
        { height: [`${from}px`, `${to}px`] },
        { duration: DURATION, easing: 'ease' },
      );
      running.set(d, anim);
      anim.onfinish = () => {
        d.open = open;
        d.style.overflow = '';
        running.delete(d);
      };
      anim.oncancel = () => {
        d.style.overflow = '';
      };
    };

    items.forEach((d) => {
      d.dataset.state = d.open ? 'open' : 'closed';
      d.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        const willOpen = d.dataset.state !== 'open';
        items.forEach((o) => {
          if (o !== d && o.dataset.state === 'open') {
            o.dataset.state = 'closed';
            setOpen(o, false);
          }
        });
        d.dataset.state = willOpen ? 'open' : 'closed';
        setOpen(d, willOpen);
      });
    });
  });
</script>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 72px;
    }
  }
  .intro {
    max-width: 400px;
    color: var(--color-on-dark-body);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  details {
    border-radius: var(--radius-card);
    background: var(--color-petrol-card);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: var(--tap-min);
    padding: 22px 28px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-card);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    color: var(--color-on-dark);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: var(--color-accent);
    transition: transform 0.2s ease;
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[data-state='open'] .icon::after {
    transform: rotate(0deg);
  }
  details p {
    padding: 0 28px 24px;
    max-width: 60ch;
    color: var(--color-on-dark-body);
  }
  @media (prefers-reduced-motion: reduce) {
    .icon::before,
    .icon::after {
      transition: none;
    }
  }
</style>
