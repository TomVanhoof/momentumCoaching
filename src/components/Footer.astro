---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { getContent, localizeHref, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const { t, ui } = getContent(lang);
---

<footer>
  <div class="container inner">
    <a href={localizeHref(lang, '/')} class="brand" aria-label={`${site.name} · ${site.company}`}>
      <Logo />
    </a>
    <nav aria-label={ui.footerNav}>
      {t.footerNav.map((item) => <a href={localizeHref(lang, item.href)}>{item.label}</a>)}
    </nav>
    <p>© {site.year} {t.footer.copyright} · {t.footer.companyNumberLabel} {site.companyNumber}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-line);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    padding-block: 40px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap-min);
    color: var(--color-ink);
    text-decoration: none;
  }
  .brand :global(svg) {
    width: 200px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-muted);
  }
</style>
