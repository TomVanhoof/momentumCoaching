---
import Icon from './Icon.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
interface Props {
  name: string;
  blurb: string;
  price: string;
  unit: string;
  features: string[];
  cta: string;
  featured?: boolean;
  href?: string;
  /** Heading level, so /packages (h1 above) can use h2 */
  level?: 'h2' | 'h3';
  /** Extra detail used on /packages */
  photoLabel?: string;
  bestFor?: string;
  bestForLabel?: string;
  terms?: string;
  /** Commitment discount, shown as a quiet line under the price */
  discount?: { percent: number; text: string };
}
const {
  name,
  blurb,
  price,
  unit,
  features,
  cta,
  featured = false,
  href = '/#contact',
  level: Heading = 'h3',
  photoLabel,
  bestFor,
  bestForLabel = 'Best for:',
  terms,
  discount,
} = Astro.props;
const detailed = Boolean(photoLabel || bestFor || terms);
// Rows the card spans in the parent grid (see subgrid in styles): top, price, features, button + optional photo / best-for
// '€ 150' -> '€ 120' (assumes a leading currency symbol followed by the amount)
const discounted = (() => {
  if (!discount) return undefined;
  const match = price.match(/^(\D*)(\d+(?:[.,]\d+)?)(.*)$/);
  if (!match) return undefined;
  const [, symbol, amount, rest] = match;
  const value = (Number(amount.replace(',', '.')) * (100 - discount.percent)) / 100;
  return `${symbol}${Number.isInteger(value) ? value : value.toFixed(2)}${rest}`;
})();
const rows = 4 + Number(Boolean(photoLabel)) + Number(Boolean(bestFor));
---

<article class:list={['card', { featured, detailed }]} style={`--rows:${rows}`}>
  {photoLabel && <PhotoPlaceholder label={photoLabel} minHeight={180} labelWidth={240} variant={featured ? 'dark' : 'light'} small />}
  <div class="top">
    <Heading>{name}</Heading>
    <p class="blurb">{blurb}</p>
  </div>
  {bestFor && <p class="best"><strong>{bestForLabel}</strong> {bestFor}</p>}
  <div class="price-block">
    <p class="price">
      <span class="amount">{price}</span>
      <span class="unit">{unit}</span>
    </p>
    {terms && <p class="terms">{terms}</p>}
    {discount && discounted && (
      <p class="discount">
        <span class="chip">−{discount.percent}%</span>
        <span>{discount.text} · {discounted} {unit}</span>
      </p>
    )}
  </div>
  <ul>
    {features.map((f) => (
      <li><Icon name="check" size={20} stroke={2.2} class="tick" />{f}</li>
    ))}
  </ul>
  <a {href} class:list={['btn', 'btn--lg', 'btn--block', featured ? 'btn--primary' : 'btn--outline']}>{cta}</a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 36px;
    border-radius: var(--radius-card-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .detailed {
    gap: 22px;
  }
  .featured {
    background: var(--color-graphite);
    border: 0; /* no border, so the gradient strip reaches the card edge */
    padding: 37px; /* keeps the card the same size */
    color: var(--color-on-dark);
    position: relative;
    overflow: hidden;
  }
  /* Gradient E: strip along the top edge of the featured card */
  .featured::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: linear-gradient(90deg, #FCCA82 0%, #D7D7F4 60%);
  }
  .top {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .top :global(h2),
  .top :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
  }
  .detailed .top :global(h2) {
    font-size: 30px;
  }
  .blurb {
    font-size: 16px;
    color: var(--color-body);
  }
  .featured .blurb {
    color: var(--color-on-dark-body);
  }
  .best {
    font-size: var(--text-small);
  }
  .detailed .price-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 18px;
    border-block: 1px solid var(--color-line);
  }
  .featured.detailed .price-block {
    border-color: rgba(255, 255, 255, 0.14);
  }
  /* Keep the amount on one line; the unit may wrap underneath */
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }
  .amount {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 600;
    white-space: nowrap;
  }
  .unit,
  .terms {
    font-size: 15px;
    color: var(--color-muted);
  }
  .terms {
    font-size: 14px;
  }
  .featured .unit,
  .featured .terms {
    color: var(--color-on-dark-body);
  }
  .discount {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .chip {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-energy);
    color: var(--color-ink);
    font-weight: 700;
    font-size: 13px;
  }
  .featured .discount {
    color: var(--color-on-dark-body);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 16px;
  }
  li {
    display: flex;
    gap: 10px;
  }
  .tick {
    flex: none;
    box-sizing: content-box;
    margin-top: -2px;
    padding: 4px;
    border-radius: 50%;
    background: var(--color-energy);
    color: var(--color-ink);
  }
  .featured .tick {
    padding: 0;
    margin-top: 2px;
    background: none;
    color: var(--color-energy);
  }
  .btn {
    margin-top: auto;
  }
  /* Share the parent grid's rows so prices, ticks and buttons align across cards */
  @supports (grid-template-rows: subgrid) {
    .card {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span var(--rows);
      row-gap: 24px;
    }
    .detailed {
      row-gap: 22px;
    }
    .btn {
      margin-top: 0;
    }
  }
</style>
