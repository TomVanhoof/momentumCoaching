---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Parts from '../components/Parts.astro';
import { notFoundPage as p } from '../data/content.en';
---

<BaseLayout title={p.title} description={p.description} noindex>
  <section class="container wrap">
    <span class="label">{p.eyebrow}</span>
    <h1><Parts parts={p.heading} /></h1>
    <p>{p.text}</p>
    <div class="ctas">
      <Button href="/" arrow>{p.home}</Button>
      <Button href="/packages" variant="outline">{p.packages}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-block: 96px;
    text-align: center;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(46px, 5.6vw, 80px);
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  p {
    max-width: 480px;
    font-size: var(--text-lead);
    color: var(--color-body);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
</style>
